# ============================================================
# Meet Companion — Environment Variables
# ============================================================
# Copy this file to .env and edit as needed:
#     cp .env.example .env
#
# Every value below has a working default. You can start the
# application with an empty .env and configure the rest from the
# in-app onboarding flow.
#
# NEVER commit .env to version control.
# ============================================================


# ------------------------------------------------------------
# Database  (optional — defaults to a local SQLite file)
# ------------------------------------------------------------
# SQLite needs no server, no container and no setup. The file and
# its parent directory are created automatically on first run.
DATABASE_URL=sqlite+aiosqlite:///data/meet-companion.db

# To use PostgreSQL instead, point at your server. The pgvector
# extension is required and is enabled automatically if permitted.
#   docker compose up -d   # starts a ready-made pgvector server
# DATABASE_URL=postgresql+asyncpg://meet:meet_dev_password@localhost:5432/meet_companion


# ------------------------------------------------------------
# LLM  (optional — used for memory extraction and Ask AI)
# ------------------------------------------------------------
# One set of variables works for every provider. Anything left
# blank falls back to that provider's documented default.
#
# Supported: ollama, openai, anthropic, gemini, groq, xai, openai_compatible
LLM_PROVIDER=ollama

# Model name. Defaults per provider, e.g. llama3.1 for Ollama.
# LLM_MODEL=llama3.1

# Required for every hosted provider. Not needed for Ollama.
# LLM_API_KEY=

# Override only for self-hosted endpoints, proxies or gateways.
# For Ollama this is the host, default http://localhost:11434
# LLM_BASE_URL=

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=


# ------------------------------------------------------------
# MeetStream  (required only to send bots into live meetings)
# ------------------------------------------------------------
# Meet Companion uses MeetStream to join calls and produce
# transcripts. Leave blank to use notes, search and Ask AI
# without live meeting capture.
MEETSTREAM_API_KEY=
MEETSTREAM_API_BASE_URL=https://api.meetstream.ai
MEETSTREAM_WEBHOOK_SECRET=
MEETSTREAM_AGENT_CONFIG_ID=


# ------------------------------------------------------------
# MCP server  (lets the in-call agent query your meeting memory)
# ------------------------------------------------------------
# Every workspace gets its own random bearer token automatically; you
# do not need to set anything here. MCP_AUTH_TOKEN is only for keeping
# an already-wired agent working after upgrading from an older install.
# MCP_AUTH_TOKEN=
#
# The URL MeetStream reaches this server on. For live bots this must be
# public (a domain, or a tunnel such as cloudflared/ngrok during dev);
# webhooks are delivered to the same host at /api/webhooks/meetstream.
MCP_SERVER_URL=http://localhost:8000/mcp


# ------------------------------------------------------------
# Embeddings  (runs locally — no API key, nothing leaves the machine)
# ------------------------------------------------------------
# Changing the model usually changes EMBEDDING_DIMENSION too, and
# existing embeddings must be regenerated to stay comparable.
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
CHUNK_SIZE=500
CHUNK_OVERLAP=100


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
# 127.0.0.1 keeps a fresh, not-yet-configured server private to this
# machine. Use 0.0.0.0 in containers or when others should reach it.
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
# Origins allowed to call the API with a session cookie. Only needed when
# the UI is served from a different origin than the API (the Vite dev
# server on :3000, or a separately hosted frontend). Leave empty when the
# server serves the built UI itself.
CORS_ORIGINS=["http://localhost:3000"]


# ------------------------------------------------------------
# Security
# ------------------------------------------------------------
# Session cookies are signed with a key generated on first run and kept
# in data/session.key. Set this only to supply your own (containers,
# multiple replicas). Placeholder values are ignored.
# SESSION_SECRET=
#
# Behind a reverse proxy that terminates TLS (nginx, Caddy, Railway),
# set this so the real client address and scheme are read from the
# X-Forwarded-* headers. Leave off otherwise: those headers can be forged.
TRUST_PROXY=false
#
# Let people create their own account (new workspace, or join with a code).
# Set false on a server exposed to the internet so only a signed-in owner can
# add members. The very first account is always allowed. Default: true.
# ALLOW_SELF_SIGNUP=true

# Interactive API docs at /docs. Default: on only when APP_ENV=development.
# API_DOCS=false
